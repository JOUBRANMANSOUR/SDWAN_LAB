# syntax=docker/dockerfile:1.7
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl dnsmasq-base dnsutils iperf3 iproute2 iputils-ping lftp \
      nginx-light openssh-client openssh-server openssl python3 python3-aioquic tcpdump vsftpd && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /run/sshd /srv/www /srv/ftp /var/log/nginx /opt/sdwan-lab-ssh && \
    useradd --create-home --shell /bin/bash sdwan && mkdir -p /home/sdwan/.ssh
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/generate_test_certificate.sh /usr/local/bin/generate-test-certificate
RUN chmod 0755 /usr/local/bin/generate-test-certificate && \
    /usr/local/bin/generate-test-certificate && \
    nginx -t && \
    ssh-keygen -q -t ed25519 -N '' -f /opt/sdwan-lab-ssh/id_ed25519 && \
    cp /opt/sdwan-lab-ssh/id_ed25519.pub /home/sdwan/.ssh/authorized_keys && \
    chown -R sdwan:sdwan /home/sdwan/.ssh && chmod 0700 /home/sdwan/.ssh && \
    chmod 0600 /home/sdwan/.ssh/authorized_keys /opt/sdwan-lab-ssh/id_ed25519
CMD ["sleep", "infinity"]


